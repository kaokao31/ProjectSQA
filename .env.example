# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)

# KKU Intelsphere API Key Configuration (สามารถระบุได้หลายคีย์ คั่นด้วยจุลภาค หรือใส่หลายตัวแปร)
# ตัวอย่างแบบที่ 1: คั่นด้วยจุลภาค
KKU_API_KEYS=sk-xxxx1,sk-xxxx2,sk-xxxx3

# ตัวอย่างแบบที่ 2: แยกตัวแปรตามลำดับ
# KKU_API_KEY_1=sk-xxxx1
# KKU_API_KEY_2=sk-xxxx2
# KKU_API_KEY_3=sk-xxxx3

# KKU Intelsphere API Base URL
INTELSPHERE_BASE_URL=https://intelsphere.kku.ac.th/v1

# Models Configuration
INTELSPHERE_GEMINI_MODEL=gemini-1.5-flash
INTELSPHERE_DEEPSEEK_MODEL=deepseek-chat

# Standard Fallback Keys
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
